APP_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DB_SSLMODE=require
SECRET_KEY=replace-me
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=generate-with-make_admin_hash.py
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional; configure all SMTP values on the backend to send reset emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=false
